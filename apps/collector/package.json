{
  "name": "@fleetboard/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fake-agent": "tsx scripts/fake-agent.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "@fleetboard/shared": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
