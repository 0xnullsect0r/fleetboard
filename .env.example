# FLEETBOARD configuration. Copy to .env and fill in every empty value.
# Generate secrets with:  openssl rand -hex 32   (hex avoids URL-escaping issues)

# Shared secret every agent sends on /ws/agent.
TOKEN=
# Signs the dashboard login cookie; shared by web + collector.
JWT_SECRET=

POSTGRES_USER=fleetboard
POSTGRES_PASSWORD=
POSTGRES_DB=fleetboard
# Leave empty to use the bundled db service (built from the three values above).
# Set only to point at an external Postgres.
DATABASE_URL=

# Monero node for XMR difficulty (host:port or URL) and Xelis node JSON-RPC.
DIFF_NODE=xmr.support:18081
XEL_NODE=https://node.xelis.io/json_rpc

# Name Caddy serves and gets a certificate for. Examples:
#   localhost                 internal CA (browser warns once)
#   fleet.your-tailnet.ts.net Tailscale cert (see README)
#   fleet.example.com         Let's Encrypt (needs public DNS + port 80/443)
CADDY_SITE_ADDRESS=localhost
# Host IP the published ports bind to: your server's Tailscale IP (100.x.y.z).
# Never 0.0.0.0 before the first-login credential change is done.
BIND_ADDR=127.0.0.1

# Release compose only: image tag to run. "latest" auto-updates (checked every
# UPDATE_INTERVAL seconds); set e.g. v0.2.0 to pin.
FLEETBOARD_TAG=latest
UPDATE_INTERVAL=600

# Days of hashrate history to keep.
HISTORY_DAYS=90

# --- Optional: wallets on this server (docker compose --profile wallets ...) ---
# Monero wallet is view-only. The Xelis wallet holds the full key; anyone with
# root on this server plus this file can spend it. See README before enabling.
XMR_WALLET_PASSWORD=
XMR_RESTORE_HEIGHT=0
XEL_WALLET_PASSWORD=
XEL_WALLET_RPC_PASS=
# Point the collector at them (leave empty when not using the profile).
XMR_WALLET_RPC=
XEL_WALLET_RPC=
XEL_WALLET_USER=fleet
