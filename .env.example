# FLEETBOARD configuration. Copy to .env and fill in every empty value.
# Generate secrets with:  openssl rand -hex 32

# Shared secret every agent sends on /ws/agent.
TOKEN=
# Signs the dashboard login cookie; shared by web + collector.
JWT_SECRET=

POSTGRES_USER=fleetboard
POSTGRES_PASSWORD=
POSTGRES_DB=fleetboard
# Must match the three values above; "db" is the compose service name.
DATABASE_URL=postgres://fleetboard:CHANGE_ME@db:5432/fleetboard

# Monero node for XMR difficulty (host:port or URL) and Xelis node JSON-RPC.
DIFF_NODE=xmr.support:18081
XEL_NODE=https://node.xelis.io/json_rpc

# Public name Caddy serves and gets a certificate for, e.g. fleet.tailnet-name.ts.net.
# "localhost" uses Caddy's internal CA (browser will warn once).
CADDY_SITE_ADDRESS=localhost
# Host IP the published ports bind to. Use your server's Tailscale IP (100.x.y.z),
# never 0.0.0.0 until the first-login credential change is done.
BIND_ADDR=127.0.0.1

# Optional: wallets co-hosted on the server (docker compose --profile wallets).
# The collector polls them and reports them as rig "server". See README.
XMR_WALLET_ADDRESS=
XEL_WALLET_PASSWORD=
XEL_WALLET_RPC_PASS=
