# FLEETBOARD Xelis wallet RPC (compose profile "wallets"). Downloads the
# official xelis-blockchain release and checks it against checksums.txt.
# Build from the repo root.
FROM debian:bookworm-slim AS fetch
ARG TARGETARCH
ARG XEL_VERSION=v1.25.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp/xelis
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in amd64) t=x86_64-unknown-linux-gnu ;; arm64) t=aarch64-unknown-linux-gnu ;; *) echo "unsupported $TARGETARCH"; exit 1 ;; esac; \
    base="https://github.com/xelis-project/xelis-blockchain/releases/download/$XEL_VERSION"; \
    curl -fsSL "$base/checksums.txt" -o checksums.txt; \
    curl -fSL --retry 3 "$base/$t.tar.gz" -o "$t.tar.gz"; \
    grep " $t.tar.gz\$" checksums.txt | sha256sum -c -; \
    tar -xzf "$t.tar.gz"; install -m 0755 "$t/xelis_wallet" /usr/local/bin/

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home-dir /data wallet && install -d -o wallet -g wallet -m 0700 /data
COPY --from=fetch /usr/local/bin/xelis_wallet /usr/local/bin/
COPY infra/wallets/xel-entrypoint.sh /usr/local/bin/entrypoint
USER wallet
WORKDIR /data
VOLUME /data
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/entrypoint"]
CMD ["run"]
